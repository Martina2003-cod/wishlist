# Copiá este archivo como .env y completá con los datos de tu proyecto de Firebase
# (Firebase Console → Configuración del proyecto → Tus apps → App web → Configuración del SDK)
# Si dejás estos valores vacíos, la app funciona en "modo demo" guardando en el navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
